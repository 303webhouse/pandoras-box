# Crypto Scalper (separate project)
crypto-scalper/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables (NEVER commit secrets)
.env
*.env
config/.env
.mcp.json

# Local Claude Code settings — per-machine, may hold local perms/paths; never track
