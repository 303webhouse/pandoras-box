{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "backend/**",
      "frontend/**",
      "pivot/**",
      "scripts/**",
      "requirements.txt",
      "Procfile",
      "railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
